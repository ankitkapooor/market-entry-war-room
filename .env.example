# Copy this file to .env and fill in your keys. Never put real keys in this
# file: .env is gitignored, .env.example is committed.

APP_ENVIRONMENT=development

# Free key, issued instantly: https://api.census.gov/data/key_signup.html
# Without it, the app runs on the labeled placeholder dataset in data/seed_metros.csv.
CENSUS_API_KEY=

# heuristic (no key needed) or openai
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

DATABASE_URL=sqlite:///./data/app.db

CENSUS_VINTAGE=2024
CENSUS_PRIOR_VINTAGE=2019

DEFAULT_GEOGRAPHY=metro
SENSITIVITY_ITERATIONS=1000

# Public portfolio safeguards. Zero disables an hourly limiter.
STRATEGY_REQUESTS_PER_HOUR=10
STRATEGY_DAILY_LIMIT=100
STRATEGY_CACHE_HOURS=168
STRATEGY_CACHE_MAX_SAVED=1000
SCENARIO_REQUESTS_PER_HOUR=30
SENSITIVITY_REQUESTS_PER_HOUR=10
SCENARIO_RETENTION_DAYS=7
SCENARIO_MAX_SAVED=100
